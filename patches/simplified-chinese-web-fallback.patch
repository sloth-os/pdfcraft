+/// Simplified Chinese text no Japanese face can wholly draw (潇 and 测 are Simplified-only) takes
+/// the Chinese face (LXGW WenKai Lite), in its own generated font.
+#[test]
+fn simplified_chinese_text_uses_the_chinese_fallback_face() {
+    if without_chinese_fonts("simplified_chinese_text_uses_the_chinese_fallback_face") {
+        return;
+    }
+    for paragraph in [false, true] {
+        let mut doc = text_page("BT /F2 12 Tf 72 700 Td (ab) Tj ET");
+        let replacement = "潇洒的测试段落，第二行也认识。";
+        let edit =
+            if paragraph { text::replace_block(&mut doc, 0, 0, replacement) } else { text::replace_line(&mut doc, 0, 0, replacement) }.unwrap();
+        assert_eq!(edit.substituted.as_deref(), Some("LXGW WenKai Lite Type3"), "{replacement}: {edit:?}");
+        let content = String::from_utf8_lossy(&page_content_bytes(&doc, 0)).into_owned();
+        assert!(content.contains("/PCZh"), "{replacement}: {content}");
+        assert_eq!(text::text_lines(&reopen(&doc), 0).unwrap()[0].text, replacement);
+    }
+}
+
+/// A character only the Chinese face has rides along in the leading Japanese font's glyphs, as
+/// Hebrew does (伖 is in the Japanese faces and not the Chinese one, 潇 the other way round, so no
+/// face has the whole text): the Japanese face keeps the line, and no Chinese font appears.
+#[test]
+fn a_simplified_only_character_rides_in_the_japanese_fallback_font() {
+    if without_chinese_fonts("a_simplified_only_character_rides_in_the_japanese_fallback_font") {
+        return;
+    }
+    let mut doc = text_page("BT /F2 12 Tf 72 700 Td (ab) Tj ET");
+    let edit = text::replace_line(&mut doc, 0, 0, "伖潇").unwrap();
+    assert_eq!(edit.substituted.as_deref(), Some("BIZ UDPGothic Type3"), "{edit:?}");
+    let content = String::from_utf8_lossy(&page_content_bytes(&doc, 0)).into_owned();
+    assert!(content.contains("/PCJp"), "{content}");
+    assert!(!content.contains("/PCZh"), "{content}");
+    assert_eq!(text::text_lines(&reopen(&doc), 0).unwrap()[0].text, "伖潇");
+}
